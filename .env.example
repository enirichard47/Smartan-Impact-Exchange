# Copy this file to .env.local (never commit .env.local) and fill in the values.
# On Vercel, add the same keys under Project > Settings > Environment Variables.

# The public address of the site, no trailing slash. Used for Paystack's
# return URL, share links and receipt emails.
SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# the "service_role" secret key (server only)
SUPABASE_SERVICE_ROLE_KEY=

# Paystack > Settings > API Keys & Webhooks. Use sk_test_... until launch.
PAYSTACK_SECRET_KEY=

# Receipt emails, sent through Brevo (Brevo > SMTP & API > API keys).
# RECEIPT_FROM must be a sender verified in Brevo (verify the whole domain if you can).
# RECEIPT_REPLY_TO (optional) is where donors' replies go.
BREVO_API_KEY=
RECEIPT_FROM="Smartan House <thesmartanhouse@gmail.com>"
RECEIPT_REPLY_TO="Smartan House <thesmartanhouse@gmail.com>"

# The daily automatic check (vercel.json). Any long random value; Vercel sends it
# with each scheduled call so nobody else can run the job.
CRON_SECRET=

# Admin area at /admin. Password at least 10 characters; secret at least 32
# random characters (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

